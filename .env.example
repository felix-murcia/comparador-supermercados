# ============================================================
# Comparador de Precios de Supermercados — variables de entorno
# ============================================================
# Copia este archivo y rellena los valores vacíos:
#   cp .env.example .env
#
# NUNCA commitees .env. Este archivo es la fuente de verdad de
# las variables disponibles: cualquier variable nueva debe añadirse
# aquí en el mismo PR que la introduce.
# ============================================================

# ===== Entorno =====
# dev | prod
APP_ENV=dev
# Clave secreta de la aplicación. Genera una con:
#   openssl rand -hex 32
APP_SECRET_KEY=
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# URL interna del servicio de API, usada por los proxies de Next.js para
# llamar a FastAPI desde el servidor (nunca desde el navegador).
API_INTERNAL_URL=http://api:8000
# Dominio público para TLS automático de Caddy en producción.
# En dev no se usa (Caddy sirve HTTP en :80).
DOMAIN=localhost
# Puertos publicados por docker-compose (dev) y por Caddy (prod)
API_PORT=8000
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
# Tag de las imágenes build. Nunca usar "latest" en producción.
IMAGE_TAG=0.1.0

# ===== Base de datos =====
POSTGRES_USER=app
# Genera una contraseña segura con:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_DB=precios
# Puertos del host para depurar en dev (primario y réplica)
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433
# Usuario dedicado a streaming replication.
POSTGRES_REPLICATION_USER=replicator
# Genera una contraseña segura con:
#   openssl rand -hex 32
POSTGRES_REPLICATION_PASSWORD=
# Cadenas de conexión del primario (RW) y la réplica (RO).
# El valor de POSTGRES_PASSWORD se interpola desde la variable de arriba.
DATABASE_URL_RW=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres-primary:5432/precios
DATABASE_URL_RO=postgresql+asyncpg://app:${POSTGRES_PASSWORD}@postgres-replica:5432/precios
# Tras una escritura, las lecturas del mismo usuario van al primario durante
# estos segundos para evitar leer una réplica con lag.
STICKY_READS_SEGUNDOS=5

# ===== Redis =====
REDIS_URL=redis://redis:6379/0
# TTL de la caché de búsquedas en segundos (24 h = 86400)
CACHE_TTL_SEGUNDOS=86400

# ===== Sesión (Auth.js / NextAuth) =====
# Secreto de firma de la sesión JWT. Genera uno con:
#   openssl rand -hex 32
# La API de FastAPI valida el mismo token firmado con este secreto.
NEXTAUTH_SECRET=
# TTL de la sesión JWT en segundos (30 días = 2592000).
SESSION_TTL_SEGUNDOS=2592000
# En docker-compose, NEXTAUTH_URL se deriva de WEB_BASE_URL.

# ===== Auth (Google OAuth 2.0) =====
# Crea las credenciales en Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# ===== Auth (Microsoft Entra ID) =====
# Crea la aplicación en Azure Portal.
# TENANT_ID=common permite cuentas de cualquier tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/callback/microsoft

# ===== LLM (productor de precios) =====
# Proveedor: openai | anthropic | xai | openrouter.
# El adaptador se selecciona mediante el puerto Productor.
#
# El modelo DEBE traer búsqueda web: sin ella el productor se inventa las URLs
# de las fichas y el verificador las rechaza (404/403). En OpenRouter se
# activa con el sufijo `:online`; es el valor por defecto porque es el único
# combination validado de punta a punta (ver README, "Ingesta de precios").
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o-mini:online
# URL base del proveedor (opcional; por defecto la oficial de cada uno).
LLM_BASE_URL=
# Timeout de la llamada al LLM, en segundos.
LLM_TIMEOUT_SEGUNDOS=60
# Máximo de pasadas productor → verificador
LLM_MAX_REINTENTOS=3

# ===== Observabilidad =====
# Emails con acceso al panel interno de métricas (separados por comas).
ADMIN_EMAILS=
# DSN de Sentry (api y web). Vacío = Sentry desactivado.
SENTRY_DSN=
# DSN para el navegador (las variables NEXT_PUBLIC_ se inyectan en el bundle).
NEXT_PUBLIC_SENTRY_DSN=
# Entorno que se muestra en Sentry (dev | prod).
NEXT_PUBLIC_APP_ENV=dev
# Org y proyecto de Sentry (opcionales; solo para subir source maps).
SENTRY_ORG=
SENTRY_PROJECT=
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ===== Rate limit =====
# Peticiones por minuto permitidas en POST /v1/busquedas
RATE_LIMIT_BUSQUEDAS_POR_MINUTO=10
# Peticiones por minuto permitidas al consultar el estado de un job
# (GET /v1/busquedas/{id}). La web la consulta cada 1,5 s mientras espera,
# así que necesita un margen por encima del intervalo de polling.
RATE_LIMIT_POLLING_POR_MINUTO=120
