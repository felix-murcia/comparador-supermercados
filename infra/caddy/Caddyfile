# Caddyfile base. El entorno define CADDY_SITE_ADDRESS:
#   - dev:  :80 (HTTP)
#   - prod: dominio público (HTTPS automático)
#
# El rate limit usa el plugin mholt/caddy-ratelimit, incluido en la imagen
# definida en infra/caddy/Dockerfile.
{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	# IP real del cliente. Con Cloudflare delante, todas las peticiones
	# llegan desde el proxy y {remote_host} sería el mismo para todo el
	# mundo: sin esto, un usuario que agota su cuota bloquea a los demás.
	# En dev (sin Cloudflare) no llega la cabecera y se usa la IP de conexión.
	@con_cf header CF-Connecting-IP *
	vars @con_cf ip_cliente {http.request.header.CF-Connecting-IP}
	vars ip_cliente {http.request.remote.host}

	# Límite por IP. Son dos zonas porque son dos cosas distintas:
	#
	# - busquedas: crear una búsqueda (POST) es lo caro: lanza un job de
	#   ingesta con LLM. Solo se limita la creación.
	# - polling: consultar el estado de un job (GET /busquedas/{id}) es una
	#   lectura barata, pero la web la consulta cada 1,5 s mientras espera
	#   (ADR-014). Con un único límite compartido, el polling consumía el
	#   cupo de las búsquedas y devolvía 429 con la barra de progreso
	#   congelada.
	rate_limit {
		zone busquedas {
			match {
				method POST
				path /api/v1/busquedas /api/busquedas
			}
			key {http.vars.ip_cliente}
			events {$RATE_LIMIT_BUSQUEDAS_POR_MINUTO:10}
			window 1m
		}
		zone polling {
			match {
				method GET
				path /api/v1/busquedas/* /api/busquedas/*
			}
			key {http.vars.ip_cliente}
			events {$RATE_LIMIT_POLLING_POR_MINUTO:120}
			window 1m
		}
	}

	# Auth.js gestiona sus callbacks en Next.js, no en FastAPI.
	handle /api/auth/* {
		reverse_proxy web:3000
	}

	# Proxies autenticados de Next.js: inyectan el token de sesión para que
	# el navegador nunca lo vea (ver ADR-016). Deben resolverse antes que el
	# comodín /api/* que envía el resto a FastAPI.
	handle /api/comparar* {
		reverse_proxy web:3000
	}

	handle /api/busquedas* {
		reverse_proxy web:3000
	}

	handle /api/me* {
		reverse_proxy web:3000
	}

	handle /api/listas* {
		reverse_proxy web:3000
	}

	# El prefijo /api se elimina antes de llegar a FastAPI:
	# /api/health/ready -> /health/ready
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:3000
	}
}
